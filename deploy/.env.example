# Copy to deploy/.env and fill in. Generate each password with: openssl rand -hex 24
# The database password takes effect only when the database is first created; changing it later needs ALTER USER.

# A domain whose DNS A record points at this server (HTTPS is set up automatically), or ":80" to serve plain HTTP on
# the server's IP address for a first test (sign-in works, but passwords travel unencrypted).
SITE_ADDRESS=oj.example.com

POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=

# Host directory for hidden tests, per-submission judge files and backups.
WUOJ_DATA=/srv/wuoj

# Concurrent judges, each pinned to its own CPU (see `nproc`): "1" on a 2-CPU server, "2,3" on a 4-CPU server with
# 8 GB. Leave the first CPUs to the database and the backend, and allow about 700 MB of memory per judge.
# Empty: one judge, not pinned.
OJ_JUDGE_SLOTS=

# "runsc" once gVisor is installed (see README.md). Empty: Docker's default runtime.
OJ_JUDGE_RUNTIME=

# false: only admins create accounts (import-users or the web app).
OJ_REGISTRATION_ENABLED=true
